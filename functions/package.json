{
  "name": "promptplay-functions",
  "description": "Cloud Functions für PromptPlay: Credits und Gemini-Generierung",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "npx firebase-tools emulators:start --only auth,functions,firestore",
    "deploy": "npx firebase-tools deploy --only functions,firestore:rules",
    "logs": "npx firebase-tools functions:log"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@googleapis/androidpublisher": "^42.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  }
}
